#!/usr/bin/env ruby
require_relative "../../lib/shopify_ledger/cli"

seam = ENV.fetch("SHOPIFY_TEST_CRASH", "")
abort "unknown worker crash seam" unless %w[before_commit after_commit].include?(seam)
kill_self = -> { Process.kill("KILL", Process.pid) }
exit ShopifyLedger::CLI.run(:worker, ARGV, seam.to_sym => kill_self)
